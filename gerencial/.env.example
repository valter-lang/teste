# Banco PostgreSQL (Supabase ou Postgres próprio). Use usuário com privilégios de aplicação, não superusuário.
DATABASE_URL=postgres://gerencial:gerencial@localhost:5432/gerencial
# Segredo da sessão (mínimo 32 caracteres aleatórios). Gere com: openssl rand -base64 48
SESSION_SECRET=
# Ambiente: development | homologacao | production. Dados de demonstração só são permitidos em development.
APP_ENV=development
# Caminho do Chromium usado para gerar PDF (opcional; padrão tenta Playwright).
CHROMIUM_PATH=
# Integração somente leitura com a base instalada (tabela bd_cl_inv do Supabase existente). Opcional.
BASE_INSTALADA_SUPABASE_URL=
BASE_INSTALADA_SUPABASE_KEY=
